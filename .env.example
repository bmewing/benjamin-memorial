# --- DigitalOcean Spaces ---
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=benjamin-memorial
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional. The signature check derives the site's address from the request,
# so this only needs setting to override that. Leave it empty.
PUBLIC_BASE_URL=

# --- Screening (optional) ---
# A model access key from the DigitalOcean control panel:
#   Gradient AI Platform -> Serverless Inference -> Model Access Keys
# Leave empty and nothing is screened; everything still arrives and is kept.
GRADIENT_API_KEY=
GRADIENT_MODEL=llama-4-maverick
GRADIENT_BASE_URL=https://inference.do-ai.run/v1

# Unlocks the private gallery at /private?key=...
GALLERY_KEY=
